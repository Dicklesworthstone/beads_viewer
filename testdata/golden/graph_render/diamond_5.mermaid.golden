graph TD
    classDef open fill:#50FA7B,stroke:#333,color:#000
    classDef inprogress fill:#8BE9FD,stroke:#333,color:#000
    classDef blocked fill:#FF5555,stroke:#333,color:#000
    classDef deferred fill:#FFB86C,stroke:#333,color:#000
    classDef pinned fill:#BD93F9,stroke:#333,color:#000
    classDef hooked fill:#FF79C6,stroke:#333,color:#000
    classDef review fill:#F1FA8C,stroke:#333,color:#000
    classDef custom fill:#E2E8F0,stroke:#333,color:#000
    classDef closed fill:#6272A4,stroke:#333,color:#fff

    n0["n0<br/>n0"]
    class n0 blocked
    n1["n1<br/>n1"]
    class n1 blocked
    n2["n2<br/>n2"]
    class n2 blocked
    n3["n3<br/>n3"]
    class n3 blocked
    n4["n4<br/>n4"]
    class n4 open

    n0 ==> n1
    n0 ==> n2
    n1 ==> n3
    n2 ==> n3
    n3 ==> n4
